---
import type { Product } from '../../types/product';

interface Props {
  product: Product;
}

const { product } = Astro.props;

const badgeClass: Record<string, string> = {
  new:  'badge-new',
  pre:  'badge-pre',
  sale: 'badge-sale',
};

const price = `$${product.price.toLocaleString('es-CO')} ${product.currency ?? 'COP'}`;
---

<a href={`/tienda/${product.id}`} class="product-card-link" aria-label={`Ver ${product.name}`}>
  <article class="product-card">
    <div class="product-img-wrapper relative">
      {product.badge && (
        <span class={`badge ${badgeClass[product.badge]} absolute top-3 left-3`}>
          {product.badgeLabel ?? product.badge}
        </span>
      )}
      <img
        src={product.image}
        alt={product.name}
        class="w-full h-full object-contain"
        loading="lazy"
        style="max-height:200px;"
      />
    </div>

    <div class="p-4">
      <p class="text-xs font-600 mb-1" style="color:#827378; letter-spacing:0.04em; text-transform:uppercase;">
        {product.category}
      </p>
      <h3 class="font-700 text-base mb-2" style="color:#1c1c17;">{product.name}</h3>
      <p class="font-700 text-base" style="color:#824f66;">{price}</p>
    </div>
  </article>
</a>

<style>
  .product-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: 1.5rem;
  }
  .product-card-link:focus-visible {
    outline: 2px solid #824f66;
    outline-offset: 3px;
  }
</style>
