---
import type { Product } from '../../types/product';

interface Props {
  product: Product;
}

const { product } = Astro.props;

const price = `$${product.price.toLocaleString('es-CO')} ${product.currency ?? 'COP'}`;
---

<a href={`/tienda/${product.id}`} class="product-card-link" aria-label={`Ver ${product.name}`}>
  <article class="product-card">
    <div class="product-img-wrapper relative">
      <span class="category-tag absolute top-4 right-4">{product.category}</span>
      <div class="img-skeleton"></div>
      <img
        src={product.image}
        alt={product.name}
        class="w-full h-full object-contain product-img"
        loading="lazy"
      />
    </div>

    <div class="p-5">
      <h3 class="product-name mb-3" style="font-family:'Plus Jakarta Sans', sans-serif; font-weight:700; font-size:1.05rem; color:#1c1c17;">{product.name}</h3>
      <div class="flex items-center justify-between">
        <span style="font-family:'Plus Jakarta Sans', sans-serif; font-weight:700; color:#704653;">{price}</span>
        <button
          type="button"
          class="quick-add-btn"
          aria-label={`Agregar ${product.name} al carrito`}
          data-quick-add
          data-product-id={product.id}
          data-product-name={product.name}
          data-product-price={product.price}
          data-product-currency={product.currency ?? 'COP'}
          data-product-image={product.image}
        >
          <span class="material-symbols-outlined" style="font-size:20px;">add_shopping_cart</span>
        </button>
      </div>
    </div>
  </article>
</a>

<style>
  .product-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: 1.5rem;
  }
  .product-card-link:focus-visible {
    outline: 2px solid #704653;
    outline-offset: 3px;
  }
  .product-img {
    opacity: 0;
    filter: blur(8px);
    transition: transform 0.5s cubic-bezier(0.16,1,0.3,1),
                opacity 300ms ease-out,
                filter 300ms ease-out;
  }
  .product-card:hover .product-img {
    transform: scale(1.06);
  }
  .product-img-wrapper.loaded .product-img {
    opacity: 1;
    filter: blur(0);
  }
  .product-img-wrapper.loaded .img-skeleton {
    opacity: 0;
    transition: opacity 220ms ease-out;
    pointer-events: none;
  }
  .product-name {
    transition: color 0.2s;
  }
  .product-card:hover .product-name {
    color: #704653;
  }
  .category-tag {
    background: rgba(199, 231, 219, 0.9);
    backdrop-filter: blur(6px);
    color: #4b685f;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
  }
</style>

<script>
  import { addToCart } from '../../stores/cart';

  document.querySelectorAll<HTMLImageElement>('.product-img').forEach(img => {
    const wrapper = img.closest('.product-img-wrapper');
    if (!wrapper) return;
    if (img.complete && img.naturalWidth > 0) {
      wrapper.classList.add('loaded');
    } else {
      img.addEventListener('load', () => wrapper.classList.add('loaded'), { once: true });
    }
  });

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-quick-add]');
    if (!btn) return;
    e.preventDefault();
    e.stopPropagation();

    addToCart({
      id: btn.dataset.productId ?? '',
      name: btn.dataset.productName ?? '',
      price: Number(btn.dataset.productPrice ?? 0),
      currency: btn.dataset.productCurrency ?? 'COP',
      image: btn.dataset.productImage ?? '',
    });

    btn.classList.add('added');
    const icon = btn.querySelector('.material-symbols-outlined');
    if (icon) icon.textContent = 'check';
    setTimeout(() => {
      btn.classList.remove('added');
      if (icon) icon.textContent = 'add_shopping_cart';
    }, 1500);
  });
</script>
