---
import CartButton from '../../islands/CartButton';

const navLinks = [
  { href: '/#catalogo',   label: 'Colección' },
  { href: '/#personaliza', label: 'Hecho a Mano' },
  { href: '#nosotros',    label: 'Sobre Nosotros' },
];
---

<header class="glass-nav fixed top-0 left-0 right-0 z-50">
  <div class="max-w-6xl mx-auto px-6 flex items-center justify-between h-16">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 group" style="text-decoration:none;">
      <span style="color:#824f66; font-size:1.2rem; font-weight:700; letter-spacing:-0.025em;">
        lananegra
      </span>
      <span style="color:#3d665a; font-size:1.1rem;">✿</span>
    </a>

    <!-- Nav desktop -->
    <nav class="hidden md:flex items-center gap-8">
      {navLinks.map(link => (
        <a href={link.href} class="nav-link">{link.label}</a>
      ))}
    </nav>

    <!-- Actions -->
    <div class="flex items-center gap-2">
      <!-- Search (placeholder) -->
      <button
        aria-label="Buscar"
        style="width:40px;height:40px;border-radius:9999px;background:#f1eee5;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background 0.15s;"
        onmouseover="this.style.background='#ffd8e6'"
        onmouseout="this.style.background='#f1eee5'"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#824f66" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </button>

      <!-- Cart (React island) -->
      <CartButton client:load />

      <!-- Mobile menu -->
      <button
        class="md:hidden"
        aria-label="Menú"
        style="width:40px;height:40px;border-radius:9999px;background:#f1eee5;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background 0.15s;"
        onmouseover="this.style.background='#ffd8e6'"
        onmouseout="this.style.background='#f1eee5'"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#824f66" stroke-width="2.5" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Spacer -->
<div class="h-16"></div>

<style>
  .nav-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: #504348;
    text-decoration: none;
    transition: color 0.15s;
  }
  .nav-link:hover { color: #824f66; }
</style>
