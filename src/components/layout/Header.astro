---
import CartButton from '../../islands/CartButton';

const navLinks = [
  { href: '/#catalogo',   label: 'Colección' },
  { href: '/#personaliza', label: 'Hecho a Mano' },
  { href: '/sobre-nosotros', label: 'Sobre Nosotros' },
];
---

<header class="glass-nav fixed top-0 left-0 right-0 z-50">
  <div class="max-w-[1400px] mx-auto px-6 flex items-center justify-between h-16">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 group" style="text-decoration:none;">
      <span style="font-family:'Plus Jakarta Sans', sans-serif; color:#704653; font-size:1.25rem; font-weight:800; letter-spacing:-0.025em;">
        lananegra
      </span>
    </a>

    <!-- Nav desktop -->
    <nav class="hidden md:flex items-center gap-8">
      {navLinks.map(link => (
        <a href={link.href} class="nav-link">{link.label}</a>
      ))}
    </nav>

    <!-- Actions -->
    <div class="flex items-center gap-2">
      <!-- Search (placeholder) -->
      <button aria-label="Buscar" class="icon-btn flex items-center justify-center">
        <span class="material-symbols-outlined">search</span>
      </button>

      <!-- Cart (React island): client:only porque su estado inicial depende de
           localStorage, que no existe en el servidor y causaría un mismatch de hidratación -->
      <CartButton client:only="react" />

      <!-- Mobile menu toggle -->
      <button id="mobile-menu-btn" class="icon-btn flex items-center justify-center md:hidden" aria-label="Menú" aria-expanded="false" aria-controls="mobile-menu">
        <span class="material-symbols-outlined" id="mobile-menu-icon">menu</span>
      </button>
    </div>
  </div>

  <!-- Mobile menu panel -->
  <nav id="mobile-menu" class="mobile-menu hidden flex-col md:hidden" aria-label="Menú móvil">
    {navLinks.map(link => (
      <a href={link.href} class="mobile-nav-link">{link.label}</a>
    ))}
  </nav>
</header>

<!-- Spacer -->
<div class="h-16"></div>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menuIcon = document.getElementById('mobile-menu-icon');
  const menuPanel = document.getElementById('mobile-menu');

  menuBtn?.addEventListener('click', () => {
    const isOpen = !menuPanel?.classList.contains('hidden');
    menuPanel?.classList.toggle('hidden');
    menuPanel?.classList.toggle('flex');
    menuBtn.setAttribute('aria-expanded', String(!isOpen));
    if (menuIcon) menuIcon.textContent = isOpen ? 'menu' : 'close';
  });

  menuPanel?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menuPanel.classList.add('hidden');
      menuPanel.classList.remove('flex');
      menuBtn?.setAttribute('aria-expanded', 'false');
      if (menuIcon) menuIcon.textContent = 'menu';
    });
  });
</script>

<style>
  .nav-link {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    color: #504446;
    text-decoration: none;
    transition: color 0.2s;
  }
  .nav-link:hover { color: #704653; }

  .icon-btn {
    width: 40px;
    height: 40px;
    border-radius: 9999px;
    background: transparent;
    border: none;
    cursor: pointer;
    color: #504446;
    transition: background 0.2s, color 0.2s;
  }
  .icon-btn:hover { background: #f1eee5; color: #704653; }

  .mobile-menu {
    padding: 0.5rem 1.5rem 1.25rem;
    background: #fdf9f0;
    border-top: 1px solid rgba(212, 194, 197, 0.4);
  }
  .mobile-nav-link {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    color: #504446;
    text-decoration: none;
    padding: 0.9rem 0;
    border-bottom: 1px solid rgba(212, 194, 197, 0.25);
  }
  .mobile-nav-link:last-child { border-bottom: none; }
  .mobile-nav-link:hover { color: #704653; }
</style>
