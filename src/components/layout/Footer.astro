---
const links = {
  tienda: ['Catálogo', 'Novedades', 'Personalizados', 'Cuidados'],
  info: ['Sobre Nosotras', 'Proceso', 'Testimonios', 'Blog'],
  ayuda: ['Envíos', 'Devoluciones', 'FAQ', 'Contacto'],
};
---

<footer style="background:#1c1c17; color:#f4f0e8;" class="mt-24">
  <div class="max-w-6xl mx-auto px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      <!-- Brand -->
      <div class="col-span-1">
        <div class="flex items-center gap-2 mb-4">
          <span class="text-2xl font-bold" style="color:#f5b4cf;">lananegra</span>
          <span style="color:#a4d0c1; font-size:1.25rem;">✿</span>
        </div>
        <p class="text-sm leading-relaxed mb-6" style="color:#827378;">
          Amigurumis tejidos a mano con amor. Cada compañero lleva horas de dedicación y un toque de magia artesanal.
        </p>
        <div class="flex gap-3">
          {['ig', 'fb', 'pt'].map(s => (
            <a
              href="#"
              class="w-9 h-9 rounded-full flex items-center justify-center transition-colors"
              style="background:#31312b;"
              onmouseover="this.style.background='#824f66'"
              onmouseout="this.style.background='#31312b'"
              aria-label={s}
            >
              <span class="text-xs font-bold" style="color:#f4f0e8;">{s.toUpperCase()}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Links -->
      {Object.entries(links).map(([section, items]) => (
        <div>
          <h4 class="text-sm font-700 mb-4 uppercase tracking-wider" style="color:#f5b4cf; letter-spacing:0.08em;">
            {section === 'tienda' ? 'Tienda' : section === 'info' ? 'Info' : 'Ayuda'}
          </h4>
          <ul class="space-y-2">
            {items.map(item => (
              <li>
                <a
                  href="#"
                  class="text-sm transition-colors"
                  style="color:#827378;"
                  onmouseover="this.style.color='#f4f0e8'"
                  onmouseout="this.style.color='#827378'"
                >
                  {item}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-12 pt-6 flex flex-col md:flex-row items-center justify-between gap-4" style="border-top:1px solid #31312b;">
      <p class="text-xs" style="color:#504348;">© 2026 LanaNegra. Tejido con amor.</p>
      <p class="text-xs" style="color:#504348;">Hecho a mano en cada puntada ✿</p>
    </div>
  </div>
</footer>
