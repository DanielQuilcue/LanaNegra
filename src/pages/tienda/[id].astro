---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/product/ProductCard.astro';
import AddToCart from '../../islands/AddToCart';
import { products } from '../../data/products';

export function getStaticPaths() {
  return products.map(p => ({
    params: { id: p.id },
    props: {
      product: p,
      related: products.filter(r => r.id !== p.id).slice(0, 3),
    },
  }));
}

const { product, related } = Astro.props;

const price = `$${product.price.toLocaleString('es-CO')} ${product.currency ?? 'COP'}`;
const whatsappMsg = encodeURIComponent(`Hola LanaNegra! Me interesa el ${product.name} 🧸`);
const whatsappUrl = `https://wa.me/${product.whatsapp ?? '573228369024'}?text=${whatsappMsg}`;

const badgeClass: Record<string, string> = {
  new: 'badge-new',
  pre: 'badge-pre',
  sale: 'badge-sale',
};

const galleryImages = product.thumbnails && product.thumbnails.length > 0
  ? product.thumbnails
  : [product.image];

const siteOrigin = Astro.site?.origin ?? Astro.url.origin;
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  image: galleryImages.map(img => new URL(img, siteOrigin).href),
  description: product.description ?? `${product.name} — amigurumi tejido a mano por LanaNegra.`,
  sku: product.id,
  category: product.category,
  brand: { '@type': 'Brand', name: 'LanaNegra' },
  offers: {
    '@type': 'Offer',
    url: new URL(`/tienda/${product.id}`, siteOrigin).href,
    priceCurrency: product.currency ?? 'COP',
    price: product.price,
    availability: 'https://schema.org/InStock',
  },
};
---

<BaseLayout title={`${product.name} — LanaNegra`} description={product.description} image={product.image}>

  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />

  <!-- BREADCRUMB -->
  <nav aria-label="Breadcrumb" class="max-w-[1400px] mx-auto px-6 pt-6 pb-2">
    <ol class="flex items-center gap-2 text-sm" style="color:#827376;">
      <li><a href="/" class="transition-colors hover-primary">Inicio</a></li>
      <li aria-hidden="true">•</li>
      <li><a href="/#catalogo" class="transition-colors hover-primary">Colección</a></li>
      <li aria-hidden="true">•</li>
      <li style="color:#704653; font-weight:700;">{product.name}</li>
    </ol>
  </nav>

  <!-- MAIN DETAIL -->
  <section class="max-w-[1400px] mx-auto px-6 py-10 md:py-14 grid md:grid-cols-2 gap-10 md:gap-16 items-start">

    <!-- LEFT: Imagen + thumbnails -->
    <div class="flex flex-col gap-5 anim-left">

      <!-- Blob contenedor de imagen: fondo animado que se mueve solo -->
      <div class="relative">
        <div
          class="product-blob relative flex items-center justify-center overflow-hidden"
          style="background: linear-gradient(135deg, #ffd9e2 0%, #f7f3ea 48%, #c9e9de 100%); padding: 2.5rem; aspect-ratio: 1/1;"
        >
          {product.badge && (
            <span class={`badge ${badgeClass[product.badge!]} absolute top-5 left-5 z-10`}>
              {product.badgeLabel ?? product.badge}
            </span>
          )}
          <img
            id="main-img"
            src={product.image}
            alt={product.name}
            class="w-full h-full object-contain img-crossfade"
            loading="eager"
          />
        </div>

        <!-- Fuera del blob para que el overflow-hidden + border-radius orgánico no lo recorte -->
        <button
          type="button"
          id="main-img-zoom"
          class="lightbox-trigger"
          style="top:1.75rem; right:1.75rem;"
          data-lightbox={product.image}
          data-lightbox-images={JSON.stringify(galleryImages)}
          data-lightbox-index="0"
          data-lightbox-alt={product.name}
          aria-label={`Ver ${product.name} en grande`}
        >
          <span class="material-symbols-outlined" style="font-size:20px;">zoom_in</span>
        </button>
      </div>

      <!-- Thumbnails -->
      {product.thumbnails && product.thumbnails.length > 0 && (
        <div class="flex gap-3 anim-thumbs">
          {product.thumbnails.map((src, i) => (
            <button
              class={`thumb-btn ${i === 0 ? 'thumb-active' : ''}`}
              data-src={src}
              aria-label={`Vista ${i + 1} del producto`}
              type="button"
            >
              <img src={src} alt={`${product.name} — foto ${i + 1}`} class="w-full h-full object-cover" />
            </button>
          ))}
        </div>
      )}
    </div>

    <!-- RIGHT: Info del producto -->
    <div class="flex flex-col gap-5">

      <!-- Kicker -->
      <p class="detail-kicker text-xs font-bold uppercase tracking-widest" style="color:#47645b; letter-spacing:0.12em;">
        {product.kicker ?? product.category}
      </p>

      <!-- Nombre -->
      <h1 class="detail-name" style="font-family:'Plus Jakarta Sans', sans-serif; font-weight:800; font-size:clamp(1.9rem,4vw,2.6rem); line-height:1.08; color:#1c1c17; letter-spacing:-0.025em; margin-top:-0.25rem;">
        {product.name}
      </h1>

      <!-- Precio -->
      <p class="detail-price" style="font-family:'Plus Jakarta Sans', sans-serif; font-weight:700; font-size:1.5rem; color:#8b5e6b; letter-spacing:-0.01em;">
        {price}
      </p>

      <!-- Descripción glassmorphism -->
      {product.description && (
        <blockquote class="detail-desc" style="background:rgba(199,231,219,0.35); backdrop-filter:blur(4px); border:1px solid rgba(199,231,219,0.5); border-radius:1rem; padding:1.25rem 1.5rem; margin:0;">
          <p class="text-sm leading-relaxed" style="color:#3a5750; font-style:italic;">
            "{product.description}"
          </p>
        </blockquote>
      )}

      <!-- Detalles Técnicos -->
      {product.details && (
        <div class="detail-specs flex flex-col gap-3">
          <h2 class="text-sm font-bold" style="color:#1c1c17; letter-spacing:0.04em;">
            Detalles Técnicos
          </h2>

          <div class="grid grid-cols-2 gap-3">
            <div class="spec-cell">
              <p class="spec-label">Tamaño</p>
              <p class="spec-value">{product.details.size}</p>
            </div>
            <div class="spec-cell">
              <p class="spec-label">Composición</p>
              <p class="spec-value">{product.details.composition}</p>
            </div>
          </div>

          <div class="flex items-start gap-3" style="padding: 0.5rem 0;">
            <span class="material-symbols-outlined" style="color:#47645b; font-size:18px; margin-top:1px;">shield</span>
            <div>
              <p class="spec-label">Seguridad</p>
              <p class="text-sm" style="color:#504446;">{product.details.safety}</p>
            </div>
          </div>
        </div>
      )}

      <!-- CTAs -->
      <div class="detail-cta flex flex-col gap-3">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-whatsapp"
        >
          <span class="material-symbols-outlined" style="font-size:20px;">chat_bubble</span>
          Pedir por WhatsApp
        </a>

        <AddToCart
          client:load
          id={product.id}
          name={product.name}
          price={product.price}
          currency={product.currency ?? 'COP'}
          image={product.image}
        />
      </div>

      <!-- Trust badges -->
      <div class="detail-badges flex items-center gap-6 pt-4" style="border-top: 1px solid rgba(212,194,197,0.35);">
        <div class="trust-badge">
          <span class="material-symbols-outlined" style="color:#704653;">package_2</span>
          <span>Envío Nacional</span>
        </div>
        <div class="trust-badge">
          <span class="material-symbols-outlined" style="color:#704653;">draw</span>
          <span>Hecho a Mano</span>
        </div>
        <div class="trust-badge">
          <span class="material-symbols-outlined" style="color:#704653;">eco</span>
          <span>Eco-friendly</span>
        </div>
      </div>

    </div>
  </section>

  <!-- PRODUCTOS RELACIONADOS -->
  {related.length > 0 && (
    <section style="background:#f7f3ea;" class="py-16 px-6">
      <div class="max-w-[1400px] mx-auto">
        <div class="text-center mb-10">
          <p class="text-xs font-bold uppercase tracking-widest mb-2" style="color:#827376; letter-spacing:0.1em;">
            Te podría enamorar también
          </p>
          <h2 class="section-title">Más para ti</h2>
          <div class="divider-dots"><span></span><span></span><span></span></div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
          {related.map((rp, i) => (
            <div class="reveal-item" style={`--delay: ${i * 120}ms`}>
              <ProductCard product={rp} />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

</BaseLayout>

<style>
  /* ── Easing tokens ───────────────────────────────────── */
  :root {
    --ease-expo: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-quint: cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* ── Keyframes ───────────────────────────────────────── */
  @keyframes slideUp {
    from { opacity: 0; transform: translateY(22px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes scaleIn {
    from { opacity: 0; transform: scale(0.93); }
    to   { opacity: 1; transform: scale(1); }
  }
  @keyframes blobMorph {
    0%,100% { border-radius: 42% 58% 52% 48% / 48% 52% 58% 42%; }
    33%     { border-radius: 58% 42% 48% 52% / 52% 48% 42% 58%; }
    66%     { border-radius: 48% 52% 60% 40% / 40% 60% 50% 50%; }
  }

  /* ── Entrance animations ─────────────────────────────── */
  .anim-left  { animation: scaleIn  0.7s var(--ease-expo)  both; }
  .anim-thumbs { animation: slideUp 0.5s var(--ease-quint) 0.15s both; }

  .detail-kicker { animation: slideUp 0.45s var(--ease-quint) 0.08s  both; }
  .detail-name   { animation: slideUp 0.6s  var(--ease-expo)  0.18s  both; }
  .detail-price  { animation: slideUp 0.45s var(--ease-quint) 0.28s  both; }
  .detail-desc   { animation: slideUp 0.45s var(--ease-quint) 0.38s  both; }
  .detail-specs  { animation: slideUp 0.45s var(--ease-quint) 0.48s  both; }
  .detail-cta    { animation: slideUp 0.45s var(--ease-quint) 0.58s  both; }
  .detail-badges { animation: slideUp 0.4s  var(--ease-quint) 0.7s   both; }

  /* ── Blob morph: el fondo que se mueve solo ───────────── */
  .product-blob {
    animation: blobMorph 9s ease-in-out infinite;
    will-change: border-radius;
  }

  /* ── Image crossfade ─────────────────────────────────── */
  .img-crossfade {
    transition: opacity 0.22s ease;
  }

  /* ── Thumbnail buttons ───────────────────────────────── */
  .thumb-btn {
    flex: 0 0 78px;
    height: 78px;
    border-radius: 0.875rem;
    overflow: hidden;
    border: 2px solid transparent;
    padding: 0;
    background: none;
    cursor: pointer;
    transition: border-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
    outline-offset: 2px;
  }
  .thumb-btn:hover {
    transform: scale(1.05);
    box-shadow: 0 4px 14px rgba(112,70,83,0.2);
  }
  .thumb-btn:focus-visible {
    outline: 2px solid #704653;
  }
  .thumb-btn.thumb-active {
    border-color: #704653;
    box-shadow: 0 0 0 3px rgba(112,70,83,0.14);
  }

  /* ── Spec cells ──────────────────────────────────────── */
  .spec-cell {
    background: #f7f3ea;
    border-radius: 0.75rem;
    padding: 0.875rem 1rem;
  }
  .spec-label {
    font-size: 0.68rem;
    font-weight: 700;
    color: #827376;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    margin-bottom: 0.25rem;
  }
  .spec-value {
    font-size: 0.9rem;
    font-weight: 700;
    color: #1c1c17;
  }

  /* ── WhatsApp button ─────────────────────────────────── */
  .btn-whatsapp {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    background: #47645b;
    color: #ffffff;
    padding: 0.9rem 1.75rem;
    border-radius: 9999px;
    font-weight: 700;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 1rem;
    border: none;
    cursor: pointer;
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(71,100,91,0.3);
    transition: filter 0.15s ease, transform 0.15s ease;
  }
  .btn-whatsapp:hover {
    filter: brightness(1.08);
    transform: translateY(-1px);
  }
  .btn-whatsapp:active { transform: scale(0.98); }
  .btn-whatsapp:focus-visible { outline: 2px solid #47645b; outline-offset: 3px; }


  /* ── Trust badges ────────────────────────────────────── */
  .trust-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    text-align: center;
  }
  .trust-badge span:last-child  { font-size: 0.7rem; font-weight: 600; color: #504446; }

  /* ── Hover breadcrumb ────────────────────────────────── */
  .hover-primary:hover { color: #704653; }

  /* ── Scroll reveal for related ───────────────────────── */
  .reveal-item {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.55s var(--ease-quint) var(--delay, 0ms),
                transform 0.55s var(--ease-quint) var(--delay, 0ms);
  }
  .reveal-item.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Reduced motion ──────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .anim-left, .anim-thumbs,
    .detail-kicker, .detail-name, .detail-price,
    .detail-desc, .detail-specs, .detail-cta, .detail-badges {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
    .product-blob { animation: none !important; }
    .img-crossfade { transition: none !important; }
    .reveal-item {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  /* ── Thumbnail switcher ────────────────────────────── */
  const mainImg = document.getElementById('main-img') as HTMLImageElement | null;
  const mainImgZoom = document.getElementById('main-img-zoom') as HTMLButtonElement | null;
  const thumbBtns = document.querySelectorAll<HTMLButtonElement>('.thumb-btn');

  thumbBtns.forEach((btn, i) => {
    btn.addEventListener('click', () => {
      const src = btn.dataset.src;
      if (!mainImg || !src || mainImg.src.endsWith(src)) return;

      thumbBtns.forEach(b => b.classList.remove('thumb-active'));
      btn.classList.add('thumb-active');

      mainImg.style.opacity = '0';
      setTimeout(() => {
        mainImg.src = src;
        mainImg.style.opacity = '1';
        mainImgZoom?.setAttribute('data-lightbox', src);
        mainImgZoom?.setAttribute('data-lightbox-index', String(i));
      }, 120);
    });
  });

  /* ── Scroll reveal for related products ────────────── */
  const observer = new IntersectionObserver(
    entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          (entry.target as HTMLElement).classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12 }
  );
  document.querySelectorAll('.reveal-item').forEach(el => observer.observe(el));
</script>
