---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/product/ProductCard.astro';
import AddToCart from '../../islands/AddToCart';
import { products } from '../../data/products';

export function getStaticPaths() {
  return products.map(p => ({
    params: { id: p.id },
    props: {
      product: p,
      related: products.filter(r => r.id !== p.id).slice(0, 3),
    },
  }));
}

const { product, related } = Astro.props;

const price = `$${product.price.toLocaleString('es-CO')} ${product.currency ?? 'COP'}`;
const whatsappMsg = encodeURIComponent(`Hola LanaNegra! Me interesa el ${product.name} 🧸`);
const whatsappUrl = `https://wa.me/${product.whatsapp ?? '573001234567'}?text=${whatsappMsg}`;

const badgeClass: Record<string, string> = {
  new: 'badge-new',
  pre: 'badge-pre',
  sale: 'badge-sale',
};
---

<BaseLayout title={`${product.name} — LanaNegra`} description={product.description}>

  <!-- BREADCRUMB -->
  <nav aria-label="Breadcrumb" class="max-w-6xl mx-auto px-6 pt-6 pb-2">
    <ol class="flex items-center gap-2 text-sm" style="color:#827378;">
      <li><a href="/" class="transition-colors hover-primary">Inicio</a></li>
      <li aria-hidden="true">·</li>
      <li><a href="/#catalogo" class="transition-colors hover-primary">Colección</a></li>
      <li aria-hidden="true">·</li>
      <li style="color:#1c1c17; font-weight:600;">{product.name}</li>
    </ol>
  </nav>

  <!-- MAIN DETAIL -->
  <section class="max-w-6xl mx-auto px-6 py-10 md:py-14 grid md:grid-cols-2 gap-10 md:gap-16 items-start">

    <!-- LEFT: Imagen + thumbnails -->
    <div class="flex flex-col gap-5 anim-left">

      <!-- Blob contenedor de imagen -->
      <div
        class="product-blob relative flex items-center justify-center overflow-hidden"
        style="background: linear-gradient(135deg, #ffd8e6 0%, #f7f3ea 48%, #bde9da 100%); padding: 2.5rem; aspect-ratio: 1/1;"
      >
        {product.badge && (
          <span class={`badge ${badgeClass[product.badge!]} absolute top-5 left-5 z-10`}>
            {product.badgeLabel ?? product.badge}
          </span>
        )}
        <img
          id="main-img"
          src={product.image}
          alt={product.name}
          class="w-full h-full object-contain img-crossfade"
          loading="eager"
        />
      </div>

      <!-- Thumbnails -->
      {product.thumbnails && product.thumbnails.length > 0 && (
        <div class="flex gap-3 anim-thumbs">
          {product.thumbnails.map((src, i) => (
            <button
              class={`thumb-btn ${i === 0 ? 'thumb-active' : ''}`}
              data-src={src}
              aria-label={`Vista ${i + 1} del producto`}
              type="button"
            >
              <img src={src} alt="" class="w-full h-full object-cover" />
            </button>
          ))}
        </div>
      )}
    </div>

    <!-- RIGHT: Info del producto -->
    <div class="flex flex-col gap-5">

      <!-- Kicker -->
      <p class="detail-kicker text-xs font-bold uppercase tracking-widest" style="color:#3d665a; letter-spacing:0.12em;">
        {product.kicker ?? product.category}
      </p>

      <!-- Nombre -->
      <h1 class="detail-name font-bold" style="font-size:clamp(1.9rem,4vw,2.6rem); line-height:1.08; color:#1c1c17; letter-spacing:-0.025em; margin-top:-0.25rem;">
        {product.name}
      </h1>

      <!-- Precio -->
      <p class="detail-price font-bold" style="font-size:1.5rem; color:#824f66; letter-spacing:-0.01em;">
        {price}
      </p>

      <!-- Descripción en caja menta -->
      {product.description && (
        <blockquote class="detail-desc" style="background:#e8f5f0; border-radius:1rem; padding:1.25rem 1.5rem; margin:0;">
          <p class="text-sm leading-relaxed" style="color:#1e4a3d; font-style:italic;">
            "{product.description}"
          </p>
        </blockquote>
      )}

      <!-- Detalles Técnicos -->
      {product.details && (
        <div class="detail-specs flex flex-col gap-3">
          <h2 class="text-sm font-bold" style="color:#1c1c17; letter-spacing:0.04em;">
            Detalles Técnicos
          </h2>

          <div class="grid grid-cols-2 gap-3">
            <div class="spec-cell">
              <p class="spec-label">Tamaño</p>
              <p class="spec-value">{product.details.size}</p>
            </div>
            <div class="spec-cell">
              <p class="spec-label">Composición</p>
              <p class="spec-value">{product.details.composition}</p>
            </div>
          </div>

          <div class="flex items-start gap-3" style="padding: 0.5rem 0;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#3d665a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0; margin-top:2px;">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            <div>
              <p class="spec-label">Seguridad</p>
              <p class="text-sm" style="color:#504348;">{product.details.safety}</p>
            </div>
          </div>
        </div>
      )}

      <!-- CTAs -->
      <div class="detail-cta flex flex-col gap-3">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-whatsapp"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
          </svg>
          Pedir por WhatsApp
        </a>

        <AddToCart
          client:load
          id={product.id}
          name={product.name}
          price={product.price}
          currency={product.currency ?? 'COP'}
          image={product.image}
        />
      </div>

      <!-- Trust badges -->
      <div class="detail-badges flex items-center gap-6 pt-4" style="border-top: 1px solid rgba(212,194,199,0.35);">
        <div class="trust-badge">
          <span aria-hidden="true">📦</span>
          <span>Envío Nacional</span>
        </div>
        <div class="trust-badge">
          <span aria-hidden="true">🧶</span>
          <span>Hecho a Mano</span>
        </div>
        <div class="trust-badge">
          <span aria-hidden="true">🌿</span>
          <span>Eco-friendly</span>
        </div>
      </div>

    </div>
  </section>

  <!-- PRODUCTOS RELACIONADOS -->
  {related.length > 0 && (
    <section style="background:#f7f3ea;" class="py-16 px-6">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-10">
          <p class="text-xs font-bold uppercase tracking-widest mb-2" style="color:#827378; letter-spacing:0.1em;">
            Te podría enamorar también
          </p>
          <h2 class="section-title">Más para ti</h2>
          <div class="divider-dots"><span></span><span></span><span></span></div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
          {related.map((rp, i) => (
            <div class="reveal-item" style={`--delay: ${i * 120}ms`}>
              <ProductCard product={rp} />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

</BaseLayout>

<style>
  /* ── Easing tokens ───────────────────────────────────── */
  :root {
    --ease-expo: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-quint: cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* ── Keyframes ───────────────────────────────────────── */
  @keyframes slideUp {
    from { opacity: 0; transform: translateY(22px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes scaleIn {
    from { opacity: 0; transform: scale(0.93); }
    to   { opacity: 1; transform: scale(1); }
  }
  @keyframes blobMorph {
    0%,100% { border-radius: 42% 58% 52% 48% / 48% 52% 58% 42%; }
    33%     { border-radius: 58% 42% 48% 52% / 52% 48% 42% 58%; }
    66%     { border-radius: 48% 52% 60% 40% / 40% 60% 50% 50%; }
  }

  /* ── Entrance animations ─────────────────────────────── */
  .anim-left  { animation: scaleIn  0.7s var(--ease-expo)  both; }
  .anim-thumbs { animation: slideUp 0.5s var(--ease-quint) 0.15s both; }

  .detail-kicker { animation: slideUp 0.45s var(--ease-quint) 0.08s  both; }
  .detail-name   { animation: slideUp 0.6s  var(--ease-expo)  0.18s  both; }
  .detail-price  { animation: slideUp 0.45s var(--ease-quint) 0.28s  both; }
  .detail-desc   { animation: slideUp 0.45s var(--ease-quint) 0.38s  both; }
  .detail-specs  { animation: slideUp 0.45s var(--ease-quint) 0.48s  both; }
  .detail-cta    { animation: slideUp 0.45s var(--ease-quint) 0.58s  both; }
  .detail-badges { animation: slideUp 0.4s  var(--ease-quint) 0.7s   both; }

  /* ── Blob morph ──────────────────────────────────────── */
  .product-blob {
    animation: blobMorph 9s ease-in-out infinite;
    will-change: border-radius;
  }

  /* ── Image crossfade ─────────────────────────────────── */
  .img-crossfade {
    transition: opacity 0.22s ease;
  }

  /* ── Thumbnail buttons ───────────────────────────────── */
  .thumb-btn {
    flex: 0 0 78px;
    height: 78px;
    border-radius: 0.875rem;
    overflow: hidden;
    border: 2px solid transparent;
    padding: 0;
    background: none;
    cursor: pointer;
    transition: border-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
    outline-offset: 2px;
  }
  .thumb-btn:hover {
    transform: scale(1.05);
    box-shadow: 0 4px 14px rgba(130,79,102,0.2);
  }
  .thumb-btn:focus-visible {
    outline: 2px solid #824f66;
  }
  .thumb-btn.thumb-active {
    border-color: #824f66;
    box-shadow: 0 0 0 3px rgba(130,79,102,0.14);
  }

  /* ── Spec cells ──────────────────────────────────────── */
  .spec-cell {
    background: #f7f3ea;
    border-radius: 0.75rem;
    padding: 0.875rem 1rem;
  }
  .spec-label {
    font-size: 0.68rem;
    font-weight: 700;
    color: #827378;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    margin-bottom: 0.25rem;
  }
  .spec-value {
    font-size: 0.9rem;
    font-weight: 700;
    color: #1c1c17;
  }

  /* ── WhatsApp button ─────────────────────────────────── */
  .btn-whatsapp {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    background: #3d665a;
    color: #ffffff;
    padding: 0.9rem 1.75rem;
    border-radius: 9999px;
    font-weight: 700;
    font-size: 1rem;
    border: none;
    cursor: pointer;
    text-decoration: none;
    box-shadow: 0 2px 0 0 rgba(28,48,42,0.5);
    transition: background 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .btn-whatsapp:hover {
    background: #2d5248;
    transform: translateY(-1px);
    box-shadow: 0 4px 0 0 rgba(28,48,42,0.4);
  }
  .btn-whatsapp:active { transform: translateY(1px); box-shadow: none; }
  .btn-whatsapp:focus-visible { outline: 2px solid #3d665a; outline-offset: 3px; }


  /* ── Trust badges ────────────────────────────────────── */
  .trust-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    text-align: center;
  }
  .trust-badge span:first-child { font-size: 1.2rem; }
  .trust-badge span:last-child  { font-size: 0.7rem; font-weight: 600; color: #504348; }

  /* ── Hover breadcrumb ────────────────────────────────── */
  .hover-primary:hover { color: #824f66; }

  /* ── Scroll reveal for related ───────────────────────── */
  .reveal-item {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.55s var(--ease-quint) var(--delay, 0ms),
                transform 0.55s var(--ease-quint) var(--delay, 0ms);
  }
  .reveal-item.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Reduced motion ──────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .anim-left, .anim-thumbs,
    .detail-kicker, .detail-name, .detail-price,
    .detail-desc, .detail-specs, .detail-cta, .detail-badges {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
    .product-blob { animation: none !important; }
    .img-crossfade { transition: none !important; }
    .reveal-item {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  /* ── Thumbnail switcher ────────────────────────────── */
  const mainImg = document.getElementById('main-img') as HTMLImageElement | null;
  const thumbBtns = document.querySelectorAll<HTMLButtonElement>('.thumb-btn');

  thumbBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const src = btn.dataset.src;
      if (!mainImg || !src || mainImg.src.endsWith(src)) return;

      thumbBtns.forEach(b => b.classList.remove('thumb-active'));
      btn.classList.add('thumb-active');

      mainImg.style.opacity = '0';
      setTimeout(() => {
        mainImg.src = src;
        mainImg.style.opacity = '1';
      }, 120);
    });
  });

  /* ── Scroll reveal for related products ────────────── */
  const observer = new IntersectionObserver(
    entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          (entry.target as HTMLElement).classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12 }
  );
  document.querySelectorAll('.reveal-item').forEach(el => observer.observe(el));
</script>
